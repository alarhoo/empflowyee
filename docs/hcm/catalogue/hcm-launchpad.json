	"title": "HCM Launchpad",
	"runtimeId": "hcm",
	"appCatalogue": "./hcm-app-catalogue.json",
	"principles": [
		"Catalogues control which apps are discoverable; pages contain only a curated default selection.",
		"Business-role assignments are additive when a person has more than one role.",
		"Tile visibility is not authorization: subscribed entitlement and allowed functions are checked independently.",
		"Sensitive payroll, compensation, wellbeing, investigation, audit, and privacy apps require narrower functions than their parent role.",
		"Customer-account, initial organisation-setup, vendor-operations, marketing, and external-participant apps stay in their owning runtimes."
	],
