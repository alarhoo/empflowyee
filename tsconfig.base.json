{
	"compileOnSave": false,
	"compilerOptions": {
		"rootDir": ".",
		"sourceMap": true,
		"declaration": false,
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"importHelpers": true,
		"target": "ES2022",
		"module": "ESNext",
		"lib": ["ES2022", "DOM"],
		"skipLibCheck": true,
		"skipDefaultLibCheck": true,
		"strict": true,
		"paths": {
			"@empflowyee/platform-runtime-contract": ["./libs/platform/contracts/runtime/src/index.ts"],
			"@empflowyee/platform-web-runtime-shell": ["./libs/platform/web/runtime/shell/src/index.ts"],
			"@empflowyee/platform-api-runtime-module": ["./libs/platform/api/runtime/module/src/index.ts"]
		}
	},
	"exclude": ["node_modules", "tmp", "dist"]
}
