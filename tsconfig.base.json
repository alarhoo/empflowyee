{
	"compileOnSave": false,
	"compilerOptions": {
		"rootDir": ".",
		"sourceMap": true,
		"declaration": false,
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"importHelpers": true,
		"target": "ES2022",
		"module": "ESNext",
		"lib": ["ES2022", "DOM"],
		"skipLibCheck": true,
		"skipDefaultLibCheck": true,
		"strict": true,
		"paths": {
			"@empflowyee/platform-runtime-contract": ["./libs/platform/contracts/runtime/src/index.ts"],
			"@empflowyee/platform-web-runtime-shell": ["./libs/platform/web/runtime/shell/src/index.ts"],
			"@empflowyee/platform-api-runtime-module": [
				"./libs/platform/api/runtime/module/src/index.ts"
			],
			"@empflowyee/hcm-web-runtime-context": ["./libs/hcm/web/runtime/context/src/index.ts"],
			"@empflowyee/hcm-web-navigation-catalog": ["./libs/hcm/web/navigation/catalog/src/index.ts"],
			"@empflowyee/hcm-web-ux-theme": ["./libs/hcm/web/ux/theme/src/index.ts"],
			"@empflowyee/hcm-web-shell": ["./libs/hcm/web/shell/src/index.ts"],
			"@empflowyee/hcm-web-ux-feature-theme-lab": [
				"./libs/hcm/web/ux/feature-theme-lab/src/index.ts"
			],
			"@empflowyee/hcm-web-ux-floorplan-object-page": [
				"./libs/hcm/web/ux/floorplans/object-page/src/index.ts"
			],
			"@empflowyee/hcm-web-ux-floorplan-list-report": [
				"./libs/hcm/web/ux/floorplans/list-report/src/index.ts"
			],
			"@empflowyee/hcm-web-ux-floorplan-worklist": [
				"./libs/hcm/web/ux/floorplans/worklist/src/index.ts"
			],
			"@empflowyee/hcm-web-ux-floorplan-overview-page": [
				"./libs/hcm/web/ux/floorplans/overview-page/src/index.ts"
			],
			"@empflowyee/hcm-web-ux-floorplan-analytical-list-page": [
				"./libs/hcm/web/ux/floorplans/analytical-list-page/src/index.ts"
			],
			"@empflowyee/hcm-web-ux-forms": ["./libs/hcm/web/ux/forms/src/index.ts"],
			"@empflowyee/hcm-web-ux-tables": ["./libs/hcm/web/ux/tables/src/index.ts"],
			"@empflowyee/hcm-web-ux-floorplan-dynamic-page": [
				"./libs/hcm/web/ux/floorplans/dynamic-page/src/index.ts"
			]
		}
	},
	"exclude": ["node_modules", "tmp", "dist"]
}
