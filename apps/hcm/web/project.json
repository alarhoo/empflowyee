{
	"name": "hcm-web",
	"$schema": "../../../node_modules/nx/schemas/project-schema.json",
	"projectType": "application",
	"prefix": "ef-hcm",
	"sourceRoot": "apps/hcm/web/src",
	"tags": ["product:hcm", "runtime:web", "domain:shell", "type:app"],
	"targets": {
		"build": {
			"executor": "@angular/build:application",
			"outputs": ["{options.outputPath}"],
			"defaultConfiguration": "production",
			"options": {
				"outputPath": "dist/apps/hcm/web",
				"browser": "apps/hcm/web/src/main.ts",
				"polyfills": ["zone.js"],
				"tsConfig": "apps/hcm/web/tsconfig.app.json",
				"inlineStyleLanguage": "scss",
				"assets": [
					{
						"glob": "**/*",
						"input": "apps/hcm/web/public",
						"output": ""
					},
					{
						"glob": "**/css_variables.css",
						"input": "node_modules/@sap-theming/theming-base-content/content/Base/baseLib",
						"output": "assets/hcm/theming/Base/baseLib"
					},
					{
						"glob": "sap_horizon*.css",
						"input": "node_modules/fundamental-styles/dist/theming",
						"output": "assets/hcm/fundamental"
					},
					{
						"glob": "*.woff2",
						"input": "node_modules/@sap-theming/theming-base-content/content/Base/baseLib/baseTheme/fonts",
						"output": "assets/hcm/theming/Base/baseLib/baseTheme/fonts"
					},
					{
						"glob": "*.woff2",
						"input": "node_modules/@sap-theming/theming-base-content/content/Base/baseLib/sap_horizon/fonts",
						"output": "assets/hcm/theming/Base/baseLib/sap_horizon/fonts"
					}
				],
				"styles": ["apps/hcm/web/src/styles.scss"]
			},
			"configurations": {
				"production": {
					"budgets": [
						{
							"type": "initial",
							"maximumWarning": "500kb",
							"maximumError": "1mb"
						},
						{
							"type": "anyComponentStyle",
							"maximumWarning": "4kb",
							"maximumError": "8kb"
						}
					],
					"outputHashing": "all"
				},
				"development": {
					"optimization": false,
					"extractLicenses": false,
					"sourceMap": true
				}
			}
		},
		"serve": {
			"continuous": true,
			"executor": "@angular/build:dev-server",
			"defaultConfiguration": "development",
			"options": {
				"port": 4302,
				"proxyConfig": "apps/hcm/web/proxy.conf.json",
				"allowedHosts": [
					"acme.localhost",
					"suspended.localhost",
					"grace.localhost",
					"trial.localhost",
					"deactivated.localhost"
				]
			},
			"configurations": {
				"production": {
					"buildTarget": "hcm-web:build:production"
				},
				"development": {
					"buildTarget": "hcm-web:build:development"
				}
			}
		},
		"lint": {
			"executor": "@nx/eslint:lint"
		},
		"test": {
			"executor": "@angular/build:unit-test",
			"options": {
				"watch": false
			}
		},
		"serve-static": {
			"continuous": true,
			"executor": "@nx/web:file-server",
			"options": {
				"buildTarget": "hcm-web:build",
				"port": 4302,
				"staticFilePath": "dist/apps/hcm/web/browser",
				"spa": true
			}
		},
		"storybook": {
			"executor": "@storybook/angular:start-storybook",
			"options": {
				"port": 6006,
				"configDir": "apps/hcm/web/.storybook",
				"browserTarget": "hcm-web:build:development",
				"compodoc": false,
				"tsConfig": "apps/hcm/web/.storybook/tsconfig.json",
				"styles": ["apps/hcm/web/src/styles.scss", "apps/hcm/web/.storybook/workshop.scss"],
				"assets": [
					{
						"glob": "**/css_variables.css",
						"input": "node_modules/@sap-theming/theming-base-content/content/Base/baseLib",
						"output": "assets/hcm/theming/Base/baseLib"
					},
					{
						"glob": "sap_horizon*.css",
						"input": "node_modules/fundamental-styles/dist/theming",
						"output": "assets/hcm/fundamental"
					},
					{
						"glob": "*.woff2",
						"input": "node_modules/@sap-theming/theming-base-content/content/Base/baseLib/baseTheme/fonts",
						"output": "assets/hcm/theming/Base/baseLib/baseTheme/fonts"
					},
					{
						"glob": "*.woff2",
						"input": "node_modules/@sap-theming/theming-base-content/content/Base/baseLib/sap_horizon/fonts",
						"output": "assets/hcm/theming/Base/baseLib/sap_horizon/fonts"
					}
				],
				"experimentalZoneless": false
			},
			"configurations": {
				"ci": {
					"quiet": true
				}
			}
		},
		"build-storybook": {
			"executor": "@storybook/angular:build-storybook",
			"outputs": ["{options.outputDir}"],
			"options": {
				"outputDir": "dist/storybook/hcm-web",
				"configDir": "apps/hcm/web/.storybook",
				"browserTarget": "hcm-web:build:development",
				"compodoc": false,
				"tsConfig": "apps/hcm/web/.storybook/tsconfig.json",
				"styles": ["apps/hcm/web/src/styles.scss", "apps/hcm/web/.storybook/workshop.scss"],
				"assets": [
					{
						"glob": "**/css_variables.css",
						"input": "node_modules/@sap-theming/theming-base-content/content/Base/baseLib",
						"output": "assets/hcm/theming/Base/baseLib"
					},
					{
						"glob": "sap_horizon*.css",
						"input": "node_modules/fundamental-styles/dist/theming",
						"output": "assets/hcm/fundamental"
					},
					{
						"glob": "*.woff2",
						"input": "node_modules/@sap-theming/theming-base-content/content/Base/baseLib/baseTheme/fonts",
						"output": "assets/hcm/theming/Base/baseLib/baseTheme/fonts"
					},
					{
						"glob": "*.woff2",
						"input": "node_modules/@sap-theming/theming-base-content/content/Base/baseLib/sap_horizon/fonts",
						"output": "assets/hcm/theming/Base/baseLib/sap_horizon/fonts"
					}
				],
				"experimentalZoneless": false
			},
			"configurations": {
				"ci": {
					"quiet": true
				}
			}
		},
		"test-storybook": {
			"executor": "nx:run-commands",
			"options": {
				"command": "test-storybook -c apps/hcm/web/.storybook --url=http://localhost:6006 --maxWorkers=1"
			}
		},
		"static-storybook": {
			"executor": "@nx/web:file-server",
			"dependsOn": ["build-storybook"],
			"options": {
				"buildTarget": "hcm-web:build-storybook",
				"staticFilePath": "dist/storybook/hcm-web",
				"spa": true,
				"port": 6006
			},
			"configurations": {
				"ci": {
					"buildTarget": "hcm-web:build-storybook:ci"
				}
			}
		}
	},
	"implicitDependencies": [
		"hcm-web-ux-*",
		"hcm-web-runtime-context",
		"hcm-web-navigation-catalog",
		"hcm-web-shell"
	]
}
