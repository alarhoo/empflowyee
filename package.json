		"@typescript-eslint/utils": "^8.58.0",
		"@vitest/coverage-v8": "~4.1.0",
		"@vitest/ui": "~4.1.0",
		"angular-eslint": "^22.1.0",
		"eslint": "^9.39.4",
		"eslint-config-next": "^16.1.6",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-import": "2.31.0",
		"eslint-plugin-jsdoc": "64.5.4",
		"eslint-plugin-jsx-a11y": "6.10.1",
		"eslint-plugin-playwright": "^1.6.2",
		"eslint-plugin-react": "^7.35.0",
		"eslint-plugin-react-hooks": "5.0.0",
		"jsdom": "^27.1.0",
		"nx": "23.2.1",
		"prettier": "^3.6.2",
		"storybook": "^10.5.0",
		"ts-node": "10.9.1",
		"tslib": "^2.3.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.69.0",
		"vite": "^8.0.0",
		"vitest": "^4.0.8",
		"webpack": "^5.101.3",
		"webpack-cli": "^7.0.0",
		"webpack-dev-server": "^5.2.1"
	},
	"dependencies": {
		"@angular/animations": "22.1.7",
		"@angular/cdk": "22.1.0",
		"@angular/common": "~22.1.0",
		"@angular/compiler": "~22.1.0",
		"@angular/core": "~22.1.0",
		"@angular/forms": "~22.1.0",
		"@angular/platform-browser": "~22.1.0",
		"@angular/router": "~22.1.0",
		"@fundamental-ngx/cdk": "^0.64.3",
		"@fundamental-ngx/core": "^0.64.3",
		"@fundamental-ngx/i18n": "^0.64.3",
		"@fundamental-ngx/platform": "^0.64.3",
		"@fundamental-ngx/ui5-webcomponents": "^0.64.3",
		"@fundamental-ngx/ui5-webcomponents-fiori": "^0.64.3",
		"@nestjs/common": "^11.0.0",
		"@nestjs/core": "^11.0.0",
		"@nestjs/platform-express": "^11.0.0",
		"@primeuix/themes": "3.0.1",
		"@sap-theming/theming-base-content": "^11.36.5",
		"@ui5/webcomponents": "^2.26.0",
		"@ui5/webcomponents-base": "^2.26.0",
		"@ui5/webcomponents-fiori": "^2.26.0",
		"@ui5/webcomponents-icons": "2.26.0",
		"axios": "^1.6.0",
		"fundamental-styles": "^0.41.8",
		"kysely": "0.29.6",
		"next": "~16.1.6",
		"pg": "8.23.0",
		"primeng": "22.1.1",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"reflect-metadata": "^0.2.0",
		"rxjs": "~7.8.0",
		"zone.js": "~0.16.2"
	}
}
