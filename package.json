{
	"name": "empflowyee",
	"version": "0.0.0",
	"private": true,
	"packageManager": "pnpm@12.5.1",
	"engines": {
		"node": ">=24.15.0 <25"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "24.21.0",
			"onFail": "download"
		}
	},
	"scripts": {
		"hcm:db:migrate": "node tools/hcm-database/migrate.mts",
		"hcm:db:test": "vitest run --config tools/hcm-database/vitest.config.mts",
		"scaffold": "node tools/scaffold/scaffold.mjs",
		"scaffold:projects": "node tools/scaffold/scaffold-projects.mjs",
		"scaffold:ui": "node tools/scaffold/install-ui-stacks.mjs",
		"architecture:check": "node tools/architecture/verify.mjs",
		"docs:check": "node tools/documentation/verify.mjs",
		"ux:check-pages": "node tools/ux/check-page-structure.mjs",
		"graph": "nx graph",
		"format": "nx format:write",
		"format:check": "nx format:check",
		"lint": "nx run-many -t lint",
		"lint:tooling": "eslint eslint.config.mjs \"tools/**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}\" \"infra/**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}\" --max-warnings=0",
		"test:lint-policy": "node --test tools/lint/*.test.mjs",
		"test": "nx run-many -t test",
		"build": "nx run-many -t build",
		"affected": "nx affected -t lint,test,build",
		"dev:marketing": "nx dev marketing-web --port=4200",
		"dev:account": "nx serve account-web --port=4300",
		"dev:hcm": "nx serve hcm-web --port=4302",
		"dev:console": "nx serve console-web --port=4301",
		"dev:account-api": "nx serve account-api",
		"dev:hcm-api": "node tools/hcm-factory/start-local-api.mjs",
		"dev:console-api": "nx serve console-api",
		"dev:hcm:preview": "nx serve hcm-web --port=4303 --host=127.0.0.1",
		"hcm:catalogue:validate": "node tools/hcm-factory/validate-catalogue.mjs",
		"hcm:app:context": "node tools/hcm-factory/app-context.mjs",
		"hcm:wave:context": "node tools/hcm-factory/wave-context.mjs",
		"hcm:structure:materialize": "node tools/hcm-factory/materialize-hcm-structure.mjs",
		"hcm:structure:dry-run": "node tools/hcm-factory/materialize-hcm-structure.mjs --dry-run",
		"hcm:catalogue:generate": "node tools/hcm-factory/generate-runtime-catalogue.mjs",
		"hcm:catalogue:check": "node tools/hcm-factory/generate-runtime-catalogue.mjs --check"
	},
	"devDependencies": {
		"@analogjs/vite-plugin-angular": "~2.6.0",
		"@analogjs/vitest-angular": "~2.6.0",
		"@angular-devkit/core": "~22.1.0",
		"@angular-devkit/schematics": "~22.1.0",
		"@angular/build": "~22.1.0",
		"@angular/cli": "~22.1.0",
		"@angular/compiler-cli": "~22.1.0",
		"@angular/language-service": "~22.1.0",
		"@axe-core/playwright": "4.13.0",
		"@eslint/js": "9.39.4",
		"@nestjs/schematics": "^11.0.0",
		"@nestjs/testing": "^11.0.0",
		"@next/eslint-plugin-next": "^16.1.6",
		"@nx/angular": "23.2.1",
		"@nx/devkit": "23.2.1",
		"@nx/docker": "23.2.1",
		"@nx/eslint": "23.2.1",
		"@nx/eslint-plugin": "23.2.1",
		"@nx/js": "23.2.1",
		"@nx/nest": "23.2.1",
		"@nx/next": "23.2.1",
		"@nx/node": "23.2.1",
		"@nx/playwright": "23.2.1",
		"@nx/react": "23.2.1",
		"@nx/storybook": "23.2.1",
		"@nx/vite": "23.2.1",
		"@nx/vitest": "23.2.1",
		"@nx/web": "23.2.1",
		"@nx/webpack": "23.2.1",
		"@oxc-project/runtime": "^0.115.0",
		"@playwright/test": "^1.37.0",
		"@schematics/angular": "~22.1.0",
		"@spartan-ng/cli": "1.4.1",
		"@storybook/angular": "^10.5.0",
		"@storybook/test-runner": "^0.24.0",
		"@stylistic/eslint-plugin": "5.10.0",
		"@swc-node/register": "~1.11.1",
		"@swc/cli": "~0.8.1",
		"@swc/core": "~1.15.5",
		"@swc/helpers": "~0.5.18",
		"@types/node": "^22.0.0",
